# 正式上线后改成 Render 的实际网址，例如：
# FEISHU_REDIRECT_URI=https://你的服务.onrender.com/api/auth/callback

# ===== 供应商计划 Base =====
FEISHU_SUPPLIER_APP_TOKEN=MdTobJKCUa5HArssAQqctz8snCc
FEISHU_SUPPLIER_TABLE_ID=tblCYpnfRvfqf7Gu

# ===== 收货记录 Base =====
FEISHU_RECEIVING_APP_TOKEN=PpFrbBKHqaAN6LsNVUoccKkPntd
FEISHU_RECEIVING_TABLE_ID=tbl7cLHZ4vZwDav0

# ===== Cookie 签名 =====
# 随机生成一串 32+ 字符的字符串。
SESSION_SECRET=请改成你自己的随机长字符串

PORT=3001

# ===== 数据库（Phase 0：独立数据库，飞书退化为同步副本） =====
# 本地开发：docker run -d --name haidilao-pg -e POSTGRES_PASSWORD=devpassword -e POSTGRES_DB=haidilao -p 5432:5432 postgres:16-alpine
# 部署到 Render 后：Render Postgres 会自动注入这个变量，不用手填
DATABASE_URL=postgres://postgres:devpassword@localhost:5432/haidilao
